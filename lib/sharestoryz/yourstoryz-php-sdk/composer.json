{
    "name": "sharestoryz/yourstoryz-php-sdk",
    "description": "An SDK to easily work with the YourStoryz API",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Henk Hazelaar",
            "email": "janhenk@concept7.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/collections": "^11||^12",
        "saloonphp/saloon": "^3"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "YourStoryz\\PhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourStoryz\\PhpSdk\\Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest -p",
        "analyse": "vendor/bin/phpstan analyse",
        "baseline": "vendor/bin/phpstan analyse --generate-baseline"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
