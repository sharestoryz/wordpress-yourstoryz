{
    "name": "sharestoryz/wordpress-yourstoryz",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "Jan Henk Hazelaar",
            "email": "janhenk@concept7.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "sharestoryz/yourstoryz-php-sdk": "0.x-dev"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "YourStoryz\\": "src/",
            "YourStoryz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable"
}
